<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MihoHediffFix</AssemblyName>
    <RootNamespace>Zades.MihoHediffFix</RootNamespace>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <Target Name="ValidateModReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldManagedDir)/Assembly-CSharp.dll')" Text="Set RimWorldManagedDir to RimWorld 1.6's Managed directory." />
    <Error Condition="!Exists('$(HarmonyAssembly)')" Text="Set HarmonyAssembly to Harmony's 0Harmony.dll." />
    <Error Condition="!Exists('$(MihoAssembly)')" Text="Set MihoAssembly to Miho's CheckHediffMakeHediff.dll." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CheckHediffMakeHediff">
      <HintPath>$(MihoAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
